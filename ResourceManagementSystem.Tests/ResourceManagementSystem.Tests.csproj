  <ItemGroup>
	<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\ResourceManagementSystem.MVC\ResourceManagementSystem.MVC.csproj" />
