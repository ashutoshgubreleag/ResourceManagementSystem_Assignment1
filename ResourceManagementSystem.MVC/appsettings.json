{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DataDirectory": "App_Data"
  },
  "Audit": {
    "FilePath": "audit-log.jsonl"
  },
  "BusinessRules": {
    "MoneyOrderIdentityThreshold": 1000,
    "HighValueMoneyOrderThreshold": 2500,
    "MaximumMoneyOrderAmount": 10000,
    "MoneyOrderFeeRate": 0.015,
    "MinimumMoneyOrderFee": 5.00,
    "IdentityVerificationFee": 2.50,
    "LowStockThreshold": 5
  },
  "Courier": {
    "MaxConcurrentRateLookups": 4,
    "RateLookupLatencyMs": 40,
    "TrackingLatencyMs": 120,
    "TrackingTimeoutMs": 1500,
    "SlowTrackingSuffix": "999"
  },
  "Performance": {
    "SlowActionThresholdMs": 500
  },
  "MaintenanceMode": {
    "Enabled": false,
    "RetryAfterSeconds": 600,
    "Message": "ApexPost Counter is undergoing scheduled maintenance. Please try again shortly.",
    "AlwaysAvailablePaths": [ "/health" ]
  },
  "IpRestriction": {
    "Enabled": true,
    "AllowList": [ "127.0.0.1", "::1", "10.20.0.0/16" ],
    "ProtectedPathPrefixes": [ "/admin", "/integration" ]
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "PartnerPermitLimit": 60,
    "PartnerWindowSeconds": 60
  },
  "Cors": {
    "PartnerTrackingWidgetOrigins": [ "https://track.swiftcourier.example" ]
  },
  "Integration": {
    "Partners": {}
  }
}
