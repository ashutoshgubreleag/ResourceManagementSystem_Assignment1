@model ResourceManagementSystem.Database.Models.ShippingOrderEntity
@{
    ViewData["Title"] = "Shipping";
}

<h2>Shipping label preview</h2>

<form asp-action="Calculate" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="ShippingType" class="form-label"></label>
            <select asp-for="ShippingType" class="form-select" asp-items="Html.GetEnumSelectList<ResourceManagementSystem.Database.Models.ShippingType>()"></select>
        </div>

        <div class="col-md-6">
            <label asp-for="DestinationZone" class="form-label"></label>
            <select asp-for="DestinationZone" class="form-select" asp-items="Html.GetEnumSelectList<ResourceManagementSystem.Database.Models.DestinationZone>()"></select>
        </div>

        <div class="col-md-6">
            <label asp-for="ServiceLevel" class="form-label"></label>
            <select asp-for="ServiceLevel" class="form-select" asp-items="Html.GetEnumSelectList<ResourceManagementSystem.Database.Models.ShippingServiceLevel>()"></select>
        </div>

        <div class="col-md-6">
            <label asp-for="WeightKg" class="form-label">Weight (kg)</label>
            <input asp-for="WeightKg" class="form-control" type="number" step="0.01" min="0.01" />
        </div>

        <div class="col-md-4">
            <label asp-for="LengthCm" class="form-label">Length (cm)</label>
            <input asp-for="LengthCm" class="form-control" type="number" step="0.01" min="0" />
        </div>

        <div class="col-md-4">
            <label asp-for="WidthCm" class="form-label">Width (cm)</label>
            <input asp-for="WidthCm" class="form-control" type="number" step="0.01" min="0" />
        </div>

        <div class="col-md-4">
            <label asp-for="HeightCm" class="form-label">Height (cm)</label>
            <input asp-for="HeightCm" class="form-control" type="number" step="0.01" min="0" />
        </div>
    </div>

    @if (Model.CalculatedPrice > 0)
    {
        <div class="alert alert-success mt-3">
            Estimated price: @Model.CalculatedPrice.ToString("0.00")
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Calculate price</button>
</form>
