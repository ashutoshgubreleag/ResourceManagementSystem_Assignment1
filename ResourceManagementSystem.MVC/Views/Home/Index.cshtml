@model ResourceManagementSystem.MVC.Models.DashboardViewModel
@{
    ViewData["Title"] = "Branch Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Branch dashboard</h2>
    <a asp-controller="Branch" asp-action="Create" class="btn btn-primary">Add branch</a>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Branches</h5>
                <h2>@Model.BranchCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Staff</h5>
                <h2>@Model.StaffCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Products</h5>
                <h2>@Model.ProductCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Low stock</h5>
                <h2>@Model.LowStockCount</h2>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Quick access</h5>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><a asp-controller="Branch" asp-action="Index">View branches</a></li>
                    <li class="list-group-item"><a asp-controller="Catalog" asp-action="Index">Catalog and stock</a></li>
                    <li class="list-group-item"><a asp-controller="Transaction" asp-action="Create">New counter transaction</a></li>
                    <li class="list-group-item"><a asp-controller="Shipping" asp-action="Index">Shipping label</a></li>
                    <li class="list-group-item"><a asp-controller="MoneyOrder" asp-action="Create">Money order</a></li>
                    <li class="list-group-item"><a asp-controller="Report" asp-action="Index">Reports</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Operational status</h5>
                <p class="text-muted mb-0">ApexPost counter operations are now managed from the branch dashboard.</p>
                <p class="mt-3"><strong>Paid transactions:</strong> @Model.ActiveTransactionCount</p>
            </div>
        </div>
    </div>
</div>
