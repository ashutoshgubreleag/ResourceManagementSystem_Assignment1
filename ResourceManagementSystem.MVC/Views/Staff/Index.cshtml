@model List<ResourceManagementSystem.Database.Models.StaffEntity>
@{
    ViewData["Title"] = "Staff";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Staff</h2>
    <a asp-action="Create" class="btn btn-primary">Add staff</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Home branch</th>
            <th>Status</th>
            <th style="width: 180px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No staff records found.</td>
            </tr>
        }
        else
        {
            @foreach (var staff in Model)
            {
                <tr>
                    <td>@staff.Name</td>
                    <td>@staff.Email</td>
                    <td>@staff.Role</td>
                    <td>@staff.HomeBranchCode</td>
                    <td>
                        @if (staff.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@staff.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            @if (staff.IsActive)
                            {
                                <form asp-action="Deactivate" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@staff.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this staff member?');">Deactivate</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
