<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApexPost</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">ApexPost</a>
                <div class="navbar-nav">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                    <a class="nav-link" asp-controller="Branch" asp-action="Index">Branches</a>
                    <a class="nav-link" asp-controller="Catalog" asp-action="Index">Catalog</a>
                    <a class="nav-link" asp-controller="Transaction" asp-action="Index">Transactions</a>
                    <a class="nav-link" asp-controller="Shipping" asp-action="Index">Shipping</a>
                    <a class="nav-link" asp-controller="MoneyOrder" asp-action="Index">Money Orders</a>
                    <a class="nav-link" asp-controller="Report" asp-action="Index">Reports</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2026 - ApexPost branch operations
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
