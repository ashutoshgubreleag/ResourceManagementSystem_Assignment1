@model ResourceManagementSystem.Database.Models.MoneyOrderEntity
@{
    ViewData["Title"] = "Create money order";
}

<h2>Create money order</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="BranchCode" class="form-label">Branch code</label>
        <input asp-for="BranchCode" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Sender" class="form-label"></label>
        <input asp-for="Sender" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Recipient" class="form-label"></label>
        <input asp-for="Recipient" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="Fee" class="form-label"></label>
        <input asp-for="Fee" class="form-control" type="number" step="0.01" />
    </div>

    <button type="submit" class="btn btn-primary">Save money order</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
