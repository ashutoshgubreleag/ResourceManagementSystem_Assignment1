@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Catalog";
}

<h2>Product catalogue and stock</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>SKU</th>
            <th>Name</th>
            <th>Category</th>
            <th>Unit price</th>
            <th>Tax</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Sku</td>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>@item.UnitPrice</td>
                <td>@item.TaxCategory</td>
                <td>@item.Quantity</td>
            </tr>
        }
    </tbody>
</table>
