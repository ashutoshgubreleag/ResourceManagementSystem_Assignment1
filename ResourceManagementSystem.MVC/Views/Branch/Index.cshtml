@model List<ResourceManagementSystem.Database.Models.BranchEntity>
@{
    ViewData["Title"] = "Branches";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Branches</h2>
    <a asp-action="Create" class="btn btn-primary">Add branch</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Region</th>
            <th>Status</th>
            <th>Opening hours</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var branch in Model)
        {
            <tr>
                <td>@branch.BranchCode</td>
                <td>@branch.Name</td>
                <td>@branch.Region</td>
                <td>@branch.Status</td>
                <td>@branch.OpeningHours</td>
            </tr>
        }
    </tbody>
</table>
