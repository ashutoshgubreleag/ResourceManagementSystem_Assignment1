@model OpenTransactionViewModel
@{
    ViewData["Title"] = "New counter transaction";
}
<h1>New counter transaction</h1>
<p class="lead">@Model.BranchName (<span class="mono">@Model.BranchCode</span>). Choose the counter terminal you are serving from.</p>
<form asp-action="Create" method="post" class="card stack">
    <partial name="_ValidationSummary" />
    <div class="form-grid">
        <div>
            <label asp-for="CounterTerminalId"></label>
            <select asp-for="CounterTerminalId">
                @foreach (var c in Model.Counters)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="row"><button type="submit" class="btn brand">Open basket</button></div>
</form>
