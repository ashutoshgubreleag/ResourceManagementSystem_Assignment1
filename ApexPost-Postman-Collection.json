{
  "info": {
    "name": "ApexPost Counter Platform",
    "description": "Sample requests for the ApexPost Counter Platform (Week 2). Set baseUrl and apiKey in the collection variables. Staff pages use cookie auth + antiforgery tokens: sign in with a browser for those; the integration API uses X-Api-Key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7052" },
    { "key": "apiKey", "value": "<set with dotnet user-secrets, paste here>" },
    { "key": "trackingNumber", "value": "APX000000000" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Integration - parcel status without key (expect 401)",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-Correlation-Id", "value": "postman-401" } ],
        "url": "{{baseUrl}}/integration/parcel-status/{{trackingNumber}}"
      }
    },
    {
      "name": "Integration - parcel status with key (200 / 404)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Api-Key", "value": "{{apiKey}}" },
          { "key": "X-Correlation-Id", "value": "postman-ok" }
        ],
        "url": "{{baseUrl}}/integration/parcel-status/{{trackingNumber}}"
      }
    },
    {
      "name": "Integration - slow courier (expect 503 after timeout)",
      "request": {
        "method": "GET",
        "header": [ { "key": "X-Api-Key", "value": "{{apiKey}}" } ],
        "url": "{{baseUrl}}/integration/parcel-status/APX261020999"
      }
    },
    {
      "name": "Integration - CORS preflight from partner widget origin",
      "request": {
        "method": "OPTIONS",
        "header": [
          { "key": "Origin", "value": "https://track.swiftcourier.example" },
          { "key": "Access-Control-Request-Method", "value": "GET" },
          { "key": "Access-Control-Request-Headers", "value": "x-api-key" }
        ],
        "url": "{{baseUrl}}/integration/parcel-status/{{trackingNumber}}"
      }
    },
    {
      "name": "Login page (GET; copy __RequestVerificationToken for a POST)",
      "request": { "method": "GET", "url": "{{baseUrl}}/Account/Login" }
    },
    {
      "name": "Report - daily sales JSON (needs auth cookie)",
      "request": { "method": "GET", "url": "{{baseUrl}}/Report/DailySales?format=json" }
    },
    {
      "name": "Report - shipping volume JSON (needs auth cookie)",
      "request": { "method": "GET", "url": "{{baseUrl}}/Report/ShippingVolume?from=2026-10-01&to=2026-10-31&format=json" }
    },
    {
      "name": "Report - low stock JSON (needs auth cookie)",
      "request": { "method": "GET", "url": "{{baseUrl}}/Report/LowStock?threshold=8&format=json" }
    },
    {
      "name": "Branch summary JSON (needs auth cookie)",
      "request": { "method": "GET", "url": "{{baseUrl}}/Branch/Summary/BR-001" }
    }
  ]
}
