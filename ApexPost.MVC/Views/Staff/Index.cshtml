@model IReadOnlyList<StaffEntity>
@{
    ViewData["Title"] = "Staff";
    var canManage = User.StaffRole is StaffRole.Administrator or StaffRole.BranchManager;
}
<div class="page-head">
    <div>
        <h1>Staff</h1>
        <p class="lead">@(User.CanSeeAllBranches ? "All branches." : $"Staff at {User.BranchCode}.") Inactive staff cannot sign in or process transactions.</p>
    </div>
    @if (canManage)
    {
        <a class="btn" asp-action="Create">Add staff member</a>
    }
</div>
<div class="card table-wrap">
    <table>
        <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Home branch</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr class="@(s.IsActive ? "" : "muted")">
                    <td>@s.Id</td>
                    <td>@s.Name</td>
                    <td>@s.Email</td>
                    <td>@s.Role</td>
                    <td class="mono">@s.HomeBranchCode</td>
                    <td><span class="badge @(s.IsActive ? "ok" : "bad")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="row">
                        @if (canManage)
                        {
                            <a class="btn small secondary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                            @if (s.IsActive && s.Id != User.StaffId)
                            {
                                <form class="inline" asp-action="Deactivate" asp-route-id="@s.Id" method="post">
                                    <button class="btn small danger" type="submit" data-confirm="Deactivate @s.Name?">Deactivate</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
