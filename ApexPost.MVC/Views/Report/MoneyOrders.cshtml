@model ApexPost.Services.Reports.MoneyOrderAuditReport
@{
    ViewData["Title"] = "Money orders and identity verifications";
    var branch = Context.Request.Query["branch"].ToString();
}
<div class="page-head">
    <div><h1>Money orders and identity verifications</h1><p class="lead">Auditor view, @Model.From.ToString("d MMM") – @Model.To.ToString("d MMM yyyy"). Document numbers are shown masked; the full number is never stored.</p></div>
    <form method="get" class="row">
        <div><label for="from">From</label><input id="from" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /></div>
        <div><label for="to">To</label><input id="to" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /></div>
        <partial name="_BranchFilter" model="branch" />
        <div><label>&nbsp;</label><button class="btn secondary" type="submit">Run</button></div>
    </form>
</div>
<div class="card table-wrap">
    <h2>Per branch</h2>
    <table>
        <thead><tr><th>Branch</th><th class="num">Issued</th><th class="num">Face value</th><th class="num">Fees</th><th class="num">High value</th><th class="num">ID passed</th><th class="num">ID failed</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr><td><span class="mono">@r.BranchCode</span> @r.BranchName</td><td class="num">@r.MoneyOrderCount</td><td class="num">@r.FaceValue</td><td class="num">@r.Fees</td><td class="num">@r.HighValueCount</td><td class="num">@r.VerificationsPassed</td><td class="num">@r.VerificationsFailed</td></tr>
            }
        </tbody>
    </table>
</div>
<div class="grid cols-2 mt">
    <div class="card table-wrap">
        <h2>Money orders</h2>
        <table>
            <thead><tr><th>Serial</th><th class="num">Amount</th><th>ID check</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var m in Model.MoneyOrders)
                {
                    <tr><td class="mono">@m.SerialNumber</td><td class="num">@m.Amount</td><td>@(m.IdentityVerificationId is int v ? $"#{v}" : "–")</td><td>@m.Status</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card table-wrap">
        <h2>Identity verifications</h2>
        <table>
            <thead><tr><th>#</th><th>Branch</th><th>Document</th><th>Staff</th><th>Result</th></tr></thead>
            <tbody>
                @foreach (var v in Model.Verifications)
                {
                    <tr><td>@v.Id</td><td class="mono">@v.BranchCode</td><td>@v.DocumentType <span class="mono">@v.MaskedDocumentNumber</span></td><td>@v.StaffId</td><td><span class="badge @(v.Result == VerificationResult.Passed ? "ok" : "bad")">@v.Result</span></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
