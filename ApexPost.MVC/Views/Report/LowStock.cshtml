@model ApexPost.Services.Reports.LowStockReport
@{
    ViewData["Title"] = "Low stock";
    var branch = Context.Request.Query["branch"].ToString();
}
<div class="page-head">
    <div><h1>Low stock</h1><p class="lead">Items at or below max(reorder level, @Model.Threshold).</p></div>
    <form method="get" class="row">
        <div><label for="threshold">Threshold</label><input id="threshold" type="number" name="threshold" value="@Model.Threshold" min="0" max="1000" /></div>
        <partial name="_BranchFilter" model="branch" />
        <div><label>&nbsp;</label><button class="btn secondary" type="submit">Run</button></div>
    </form>
</div>
<div class="card table-wrap">
    <table>
        <thead><tr><th>Branch</th><th>SKU</th><th>Product</th><th>Category</th><th class="num">On hand</th><th class="num">Reorder at</th><th class="num">Suggested order</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr><td class="mono">@r.BranchCode</td><td class="mono">@r.Sku</td><td>@r.ProductName</td><td>@r.Category</td><td class="num">@r.QuantityOnHand</td><td class="num">@r.ReorderThreshold</td><td class="num">@r.SuggestedReorder</td></tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr class="muted"><td colspan="7">Nothing is low.</td></tr>
            }
        </tbody>
    </table>
</div>
