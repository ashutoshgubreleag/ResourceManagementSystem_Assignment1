@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="card">
    <h1>@Model.StatusCode · @Model.Title</h1>
    <p class="lead">@Model.Message</p>
    @if (!string.IsNullOrEmpty(Model.CorrelationId))
    {
        <p>Reference for support: <code>@Model.CorrelationId</code></p>
    }
    <a class="btn secondary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
</div>
