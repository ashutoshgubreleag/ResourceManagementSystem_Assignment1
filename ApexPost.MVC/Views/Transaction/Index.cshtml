@model IReadOnlyList<TransactionEntity>
@{
    ViewData["Title"] = "Transactions";
}
<div class="page-head">
    <div>
        <h1>Counter transactions</h1>
        <p class="lead">@(User.CanSeeAllBranches ? "All branches" : $"Branch {User.BranchCode}"), most recent first.</p>
    </div>
    @if (User.StaffRole is StaffRole.CounterClerk or StaffRole.BranchManager)
    {
        <a class="btn brand" asp-action="Create">New counter transaction</a>
    }
</div>
<div class="card"><partial name="_TransactionTable" model="Model" /></div>
