@model IEnumerable<TransactionEntity>
<div class="table-wrap">
    <table>
        <thead><tr><th>#</th><th>Branch</th><th>Opened (UTC)</th><th>Clerk</th><th class="num">Items</th><th class="num">Retail</th><th class="num">Services</th><th class="num">Total</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var tx in Model)
            {
                <tr>
                    <td><a asp-controller="Transaction" asp-action="Details" asp-route-id="@tx.Id">@tx.Id</a></td>
                    <td class="mono">@tx.BranchCode</td>
                    <td>@tx.CreatedAt.ToString("dd MMM HH:mm")</td>
                    <td>@tx.ClerkStaffId</td>
                    <td class="num">@tx.ItemCount</td>
                    <td class="num">@tx.RetailNet</td>
                    <td class="num">@tx.ServicesNet</td>
                    <td class="num">@tx.TotalAmount</td>
                    <td><span class="badge @(tx.Status switch { TransactionStatus.Paid => "ok", TransactionStatus.Open => "info", _ => "bad" })">@tx.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
