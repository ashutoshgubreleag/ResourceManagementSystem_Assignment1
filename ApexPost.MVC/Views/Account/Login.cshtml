@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login-wrap">
    <div class="card stack">
        <h1>Sign in</h1>
        <p class="lead">ApexPost counter staff only.</p>
        <form asp-action="Login" method="post" class="stack" novalidate>
            <partial name="_ValidationSummary" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div>
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <button type="submit" class="btn brand">Sign in</button>
        </form>
        <div class="demo-accounts">
            Demo accounts (password <code>ApexPost123!</code>): <code>clerk.br001a@apexpost.local</code>,
            <code>manager.br001@apexpost.local</code>, <code>auditor@apexpost.local</code>, <code>admin@apexpost.local</code>.
            See README for the full list.
        </div>
    </div>
</div>
