@model MoneyOrderFormViewModel
@{
    ViewData["Title"] = "Add money order";
}
<h1>Add money order</h1>
<p class="lead">Transaction @Model.TransactionId. Fee: 1.5% (minimum $5). Amounts above <strong>@(new Money(Model.IdentityThreshold))</strong> need a passed identity verification in the same transaction before payment.</p>
<form asp-action="Create" asp-route-id="@Model.TransactionId" method="post" class="card stack">
    <partial name="_ValidationSummary" />
    <input type="hidden" asp-for="IdentityThreshold" />
    <div class="form-grid">
        <div><label asp-for="Amount"></label><input asp-for="Amount" type="number" step="0.01" min="1" max="10000" /><span asp-validation-for="Amount" class="field-error"></span></div>
        <div><label asp-for="Sender"></label><input asp-for="Sender" /><span asp-validation-for="Sender" class="field-error"></span></div>
        <div><label asp-for="Recipient"></label><input asp-for="Recipient" /><span asp-validation-for="Recipient" class="field-error"></span></div>
    </div>
    <div class="row">
        <button type="submit" class="btn">Add to basket</button>
        <a class="btn secondary" asp-controller="Transaction" asp-action="Details" asp-route-id="@Model.TransactionId">Back to basket</a>
    </div>
</form>
